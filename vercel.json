{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "regions": ["bom1"],
  "functions": {
    "api/chat.ts": {
      "maxDuration": 60
    },
    "api/image.ts": {
      "maxDuration": 60
    },
    "api/title.ts": {
      "maxDuration": 30
    },
    "api/transcribe.ts": {
      "maxDuration": 30
    },
    "api/tts.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
